; Anifight -- default screenpack.
;
; This is our own screenpack, generated by tools/screenpack/gen.py from our own
; art. It is not Elecbyte's, and deliberately so: MUGEN's default data folder is
; copyrighted and is not redistributed with this project.
;
; Everything here is standard MUGEN syntax, so a real third-party screenpack can
; be dropped in its place unchanged.

[Info]
name = "Anifight Default"
author = "Anifight"
versiondate = 10,16,2026
mugenversion = 1.0
; The coordinate space every pos/offset in this file is written in.
localcoord = 320,240

[Files]
; Note the key is `spr` here. fight.def spells its own one `sff`.
spr = system.sff
snd = system.snd
select = select.def
fight = fight.def
font1 = f-6x9.fnt
font2 = f-12x18.fnt

; --------------------------------------------------------------- title screen

[Title Info]
fadein.time = 10
fadeout.time = 10
menu.pos = 160,116
menu.item.font = 1,0,0
menu.item.active.font = 1,0,0
menu.item.spacing = 0,12
; The active item is marked by the box cursor rather than by a second colour
; bank, so this screenpack does not depend on font banks existing.
menu.boxcursor.visible = 1
; Coords are measured from the text baseline, the same anchor MUGEN uses
; (`-58,-10,57,2` in the shipped motif frames a ten-ascent font). This
; screenpack's font1 is a 6x9 cell, so the frame runs from the top of the cell
; (-9) to two pixels under the baseline (+2), matching the motif's proportions.
menu.boxcursor.coords = -40,-9,39,2
menu.window.margins.y = 10,6
menu.window.visibleitems = 6

menu.itemname.arcade = "ARCADE"
menu.itemname.versus = "VS MODE"
menu.itemname.teamarcade = ""
menu.itemname.teamversus = ""
menu.itemname.teamcoop = ""
menu.itemname.survival = ""
menu.itemname.survivalcoop = ""
; --- Anifight extension: jumps straight to the fight screen with placeholder
; fighters, so the HUD, stage and camera can be exercised with an empty roster.
menu.itemname.training = "ENGINE TEST"
menu.itemname.watch = ""
menu.itemname.options = "OPTIONS"
menu.itemname.exit = "EXIT"

[TitleBGdef]
bgclearcolor = 8,10,20

[TitleBG 0]
type = normal
spriteno = 1,0
start = 0,0
layerno = 0

[TitleBG 1]
type = normal
spriteno = 1,1
start = 0,168
tile = 1,0
velocity = -0.4,0
layerno = 0

[TitleBG 2]
type = normal
spriteno = 10,0
start = 80,36
layerno = 1

[TitleBG 3]
type = normal
spriteno = 11,0
start = 0,200
layerno = 1

; ------------------------------------------------------------- select screen

[Select Info]
fadein.time = 10
fadeout.time = 10

; An 11x4 grid of 24x24 cells with 2px between them, centred on a 320x240
; screen: forty-four cells, which is what a roster of forty-one entries needs.
; It is four rows because that is all the height there is -- the on-screen pad
; claims the band below -- so the grid grew sideways instead: the cells got
; smaller (27 became 24) rather than the grid running off the right edge.
;
; The player panels sit in the strip between the pad's two thumb clusters
; below the grid, which is the only room left once the grid has taken the
; middle of the screen.
rows = 4
columns = 11
wrapping = 1
pos = 18,22
showemptyboxes = 1

; The grid reserves a cell for every entry in select.def, including the
; community characters whose folders have not been downloaded yet -- that is
; deliberate, so a roster does not renumber itself around whatever happens to
; be installed. Keeping the cursor off those cells is the other half of that
; trade: with this on, arrowing across a fresh install's grid means walking
; through two rows of blanks, and confirming on one does nothing at all.
; Off, the cursor steps over an absent character and lands on the next
; fighter that is actually there.
moveoveremptyboxes = 0
cell.size = 24,24
cell.spacing = 2
cell.bg.spr = 150,0
cell.random.spr = 151,0
cell.random.switchtime = 4

p1.cursor.startcell = 0,0
p1.cursor.active.spr = 160,0
p1.cursor.done.spr = 161,0
p2.cursor.startcell = 0,7
p2.cursor.active.spr = 170,0
p2.cursor.done.spr = 171,0

portrait.spr = 9000,0
portrait.offset = 0,0
portrait.scale = 1,1

title.offset = 160,2
title.font = 2,0,0

; Portraits come from the character's own sprite file, group 9000.
p1.face.spr = 9000,1
p1.face.offset = 20,60
p1.face.scale = 1,1
p2.face.spr = 9000,1
p2.face.offset = 300,60
p2.face.scale = 1,1
p2.face.facing = -1

p1.name.offset = 88,186
p1.name.font = 1,0,1
p2.name.offset = 222,186
p2.name.font = 1,0,-1

stage.pos = 160,172
stage.active.font = 1,0,0
stage.done.font = 1,0

; --- Anifight extension ---
; Shown centred when the roster is empty, instead of MUGEN's behaviour of
; refusing to start at all.
; Centred on the gap between the on-screen pad's thumb clusters, not on the
; screen -- see touchpad::channel().
emptymsg.offset = 155,152
emptymsg.font = 1,0,0
emptymsg.text = "NO CHARACTERS INSTALLED"

[SelectBGdef]
bgclearcolor = 10,12,24

[SelectBG 0]
type = normal
spriteno = 100,0
start = 0,0
tile = 1,1
velocity = -0.5,-0.25

[SelectBG 1]
type = normal
spriteno = 100,1
start = 85,20

; --------------------------------------------------------------- versus screen

[VS Screen]
time = 150
fadein.time = 15
fadeout.time = 15
match.text = "MATCH %i"
match.offset = 160,14
match.font = 1,0,0
; The portrait is the character's own sprite -- group 9000, which every
; character is expected to have -- so what these lines choose is where it goes
; and how big, not what it is. A character's portrait is small (24x24 here),
; which is the size a select cell wants and far too small for a card, so the
; scale is what makes one sprite serve both.
;
; p2 is mirrored about its own offset rather than positioned by its far edge,
; so the two offsets are the two portraits' inner corners at 48 and 320-48.
p1.spr = 9000,0
p1.offset = 48,72
p1.facing = 1
p1.scale = 4,4
p2.spr = 9000,0
p2.offset = 272,72
p2.facing = -1
p2.scale = 4,4
p1.name.offset = 96,182
p1.name.font = 1,0,0
p2.name.offset = 224,182
p2.name.font = 1,0,0

[VersusBGdef]
bgclearcolor = 0,0,0

[VersusBG 0]
type = normal
spriteno = 1,0
start = 0,0
layerno = 0

; -------------------------------------------------------------- victory screen

[Victory Screen]
enabled = 1
; Shorter than the VS card: the victory screen is a between-matches card, not a
; second introduction, and the corpus' own motif holds it for 300 ticks only
; because its default screenpack is wordier than this one.
time = 150
fadein.time = 8
fadeout.time = 15

; The portrait is the character's own group 9000, image 2 -- MUGEN's convention
; for the victory pose, distinct from the 9000,0/1 face used elsewhere. A
; character without one is not left blank: the engine draws its current
; animation frame fitted into `p1.window` instead. That window is also the
; clipping rectangle, so a full-body fallback cannot run into the name.
p1.spr = 9000,2
p1.offset = 96,20
p1.scale = 1,1
p1.window = 0,0,320,156

; Name and quote are centred, with font2 for the name and font1 for the quote.
; This file carries only those two fonts, which is why the compiled font-3 name
; default is overridden here. `%s` is the winner's name.
p1.name.text = "%s"
p1.name.offset = 160,166
p1.name.font = 2,0,0

; There is no [Quotes] parser in the character format yet, so this screenpack
; line is the only win quote the card has; leaving `winquote.text` empty draws
; no quote rather than inventing one. `%i` is the match number.
winquote.text = "Winner!  -  match %i"
winquote.offset = 160,194
winquote.font = 1,0,0
; The corpus sets `w`; this line is short enough to stay on one line, so `n`
; describes the layout rather than relying on wrapping to fit it.
winquote.textwrap = n
winquote.window = 16,182,304,214

; No [VictoryBGdef]: with no layers the engine fills the card black and fades
; that fill. Add a background section here if the screenpack ever grows art.

; --------------------------------------------------------------- game over
;
; A lost arcade run plays this storyboard before returning to the title.
; `gameover.def` is part of this screenpack and uses the wordmark from
; system.sff; the section is a plain switch, exactly as in MUGEN.
[Game Over Screen]
enabled = 1
storyboard = gameover.def

; ------------------------------------------------------------ title animations

; The logo pulses, so the title screen is visibly alive even with no characters.
[Begin Action 0]
10,0, 0,0, 40
10,0, 0,-2, 5
10,0, 0,0, 40
10,0, 0,2, 5

; The ground layer scrolls by on its own; no action needed.
