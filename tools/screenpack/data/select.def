[Options]
; One value per difficulty tier, read in order: 6 fights against the easiest
; opponents, then 1 against the next tier up, then 1 more. So an arcade run is
; eight fights long and steps up twice near the end. Raise the later values for
; a steeper ladder -- the tiers are 0 (gentlest) to 9.
;
; A run repeats the pool when it is shorter than the ladder, which is what a
; fourteen-fighter roster and an eight-fight run already do twice over.
arcade.maxmatches = 6,1,1,0,0,0,0,0,0,0

; The same shape for team modes. Read and reported, but nothing consumes it yet:
; team battles are not implemented.
team.maxmatches = 4,1,1,0,0,0,0,0,0,0
